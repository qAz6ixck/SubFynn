{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SubFynn",
  "version": "1.0.0",
  "identifier": "com.subfynn.app",
  "mainBinaryName": "SubFynn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "SubFynn",
        "url": "splashscreen.html",
        "width": 380,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": false
      },
      {
        "label": "main",
        "title": "SubFynn - AI Subtitle Studio",
        "url": "index.html",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../ffmpeg.exe",
      "../ffprobe.exe"
    ]
  },
  "plugins": {
    "dialog": null,
    "shell": null
  }
}
